POSTGRES_DB=recruitment_intel
POSTGRES_USER=recruitment_intel
POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-a-long-random-secret-before-use
ACCESS_TOKEN_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=20
UPLOAD_DIR=/app/private_uploads
# Generate a unique secret with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep this key in the deployment secret manager and back it up separately from encrypted uploads.
UPLOAD_ENCRYPTION_KEY=replace-with-base64-encoded-random-32-byte-key
# Local Compose uses a private local directory. Hosted Render API and worker use the same private Supabase Storage bucket.
UPLOAD_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-evidence
# Generate a second, distinct key with the same command above. It encrypts backup files.
# Store it in a separate approved recovery location; losing it makes backups unrecoverable.
BACKUP_ENCRYPTION_KEY=replace-with-a-different-base64-encoded-random-32-byte-key
MAX_UPLOAD_BYTES=10485760
# Supported range is 1 byte through 50 MiB; the Nginx proxy applies the matching request-body bound.
DATA_RETENTION_DAYS=180
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
REGISTER_MAX_REQUESTS=20
REGISTER_WINDOW_SECONDS=900
REGISTER_LOCKOUT_SECONDS=900
CORRECTION_MAX_REQUESTS=10
CORRECTION_WINDOW_SECONDS=900
CORRECTION_LOCKOUT_SECONDS=900
CAMPAIGN_LINK_THRESHOLD=40
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=
# The optional production Caddy profile uses these values. For production set
# PUBLIC_DOMAIN to your DNS name, WEB_ORIGIN to https://PUBLIC_DOMAIN, and
# VITE_API_URL to an empty value so the browser uses same-origin API routes.
PUBLIC_DOMAIN=example.invalid
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
APP_NETWORK_SUBNET=172.30.0.0/24
CADDY_PROXY_IP=172.30.0.10
# The web container proxies same-origin /api requests and Caddy does so in the production profile.
WEB_PROXY_IP=172.30.0.11
# Trust only the local proxy containers and loopback. Keep these in sync with the two proxy IP settings.
FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.30.0.10,172.30.0.11
INITIAL_INVESTIGATOR_CODE=change-this-one-time-setup-code
INITIAL_REVIEWER_CODE=change-this-separate-one-time-reviewer-code
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password
NEO4J_PASSWORD_SLASH_SAFE=false
RDAP_ENABLED=false
RDAP_TIMEOUT_SECONDS=5
RDAP_MAX_RESPONSE_BYTES=1048576
